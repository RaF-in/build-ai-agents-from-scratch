# =====================================================================
# AI Agent — environment template. Copy to `.env` and fill in.
#   cp .env.example .env
# =====================================================================

# --- LLM / provider credentials --------------------------------------
GROQ_API_KEY=
# Telegram bot (webhook server). Leave blank to run CLI only.
TELEGRAM_BOT_TOKEN=
# Web search provider key (research capability).
TAVILY_API_KEY=
# Which search backend to use: "tavily" or "ddgs" (no key needed for ddgs).
SEARCH_PROVIDER=ddgs

# --- LLM resilience (optional) ---------------------------------------
# Comma-separated fallback models tried if the primary call fails.
# For a local LM Studio model, prefix with "lm_studio/", e.g.
#   LLM_FALLBACKS=lm_studio/google/gemma-4-12b-qat
LLM_FALLBACKS=
# Per-call retry count inside the resilience wrapper.
LLM_NUM_RETRIES=

# --- LM Studio (local OpenAI-compatible endpoint, optional) ----------
# Needed when a fallback model above is prefixed "lm_studio/". litellm reads
# these automatically. API base MUST include the /v1 suffix. The key is a
# placeholder — LM Studio ignores it but litellm requires a non-empty value.
LM_STUDIO_API_BASE=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio

# --- Logfire / OpenTelemetry tracing ---------------------------------
# THE GATE: with no token, all telemetry is a complete no-op (zero overhead,
# nothing sent, console silent). Set it to turn tracing on.
LOGFIRE_TOKEN=
# Service identity shown in the Logfire UI.
OTEL_SERVICE_NAME=ai-agent
# Deployment environment label (dev / staging / prod).
AGENT_ENV=dev
# Optional build/version tag stamped on every trace (e.g. a git SHA).
AGENT_VERSION=
# Payload capture policy. Default (unset/0) = summaries only: spans carry a byte
# count + 200-char preview, never full prompts/results. Set to 1 to capture FULL
# payloads (debugging only — more data, larger spans).
TRACE_CAPTURE_CONTENT=0
# Console trace output. Default = concise spans printed alongside the app's logs.
# Set to 0 to send traces ONLY to the Logfire UI (no console span output).
TRACE_CONSOLE=1

# --- Misc agent tuning (optional) ------------------------------------
# Capabilities to disable, comma-separated (e.g. "research").
AGENT_DISABLED_CAPABILITIES=
# Path to the evaluator-calibration SQLite DB.
AGENT_CALIBRATION_DB=
# TTL (seconds) before a per-run workspace is swept.
AGENT_WORKSPACE_TTL_S=
